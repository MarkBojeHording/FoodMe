<%= link_to root_path, class:"back-button" do %>
  <i class="back fa-solid fa-arrow-left"></i>
<% end %>

<div data-controller="fetch-dishes" data-fetch-dishes-menu-dishes-value=<%= @menu.dishes.pluck(:id).to_json %>>
  <div class="row" data-fetch-dishes-target="swipers">
    <% @menu.dishes.each do |dish| %>
      <%= link_to dish_path(dish), data: { turbo: false }, class: "btn btn-primary" do %>
        View <%= dish.title %>
      <% end %>
    <% end %>
  </div>
</div>
